# syntax=docker/dockerfile:1
FROM node:24-alpine AS webbuild
WORKDIR /web
COPY portal/package.json portal/package-lock.json ./
RUN npm ci
COPY portal/ .
ARG VITE_API_BASE=http://localhost:8080
ARG VITE_GATEWAY_URL=http://localhost:8090
ARG VITE_OIDC_AUTHORITY=http://localhost:8088/realms/orbeat
ARG VITE_OIDC_CLIENT_ID=orbeat-portal
ARG VITE_MARKETPLACE_SOURCE=./marketplace
ENV VITE_API_BASE=$VITE_API_BASE VITE_GATEWAY_URL=$VITE_GATEWAY_URL \
    VITE_OIDC_AUTHORITY=$VITE_OIDC_AUTHORITY VITE_OIDC_CLIENT_ID=$VITE_OIDC_CLIENT_ID \
    VITE_MARKETPLACE_SOURCE=$VITE_MARKETPLACE_SOURCE
RUN npm run build

# Pin the Go minor line to match go.mod (1.26.x); see Dockerfile.api.
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod ./
COPY go.su[m] ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY . .
COPY --from=webbuild /web/dist ./cmd/portal/dist
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -o /out/orbeat-portal ./cmd/portal

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/orbeat-portal /orbeat-portal
EXPOSE 8081
USER nonroot:nonroot
# Container healthcheck via the binary's own self-probe (distroless has no shell
# or curl). Compose wires HEALTHCHECK; kept here as the image-level default too.
HEALTHCHECK --interval=5s --timeout=3s --start-period=10s --retries=20 \
  CMD ["/orbeat-portal", "-healthcheck"]
ENTRYPOINT ["/orbeat-portal"]
