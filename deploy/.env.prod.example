# Copy to deploy/.env.prod (git-ignored) and fill in. Generate strong secrets:
#   openssl rand -base64 36
#
# The public base domain. Requires THREE DNS A-records pointing at this host:
#   <domain>   ·   auth.<domain>   ·   mcp.<domain>
# (auth = Keycloak, mcp = the MCP gateway; both serve root-level paths so each
# gets its own subdomain rather than a path prefix.)
ORBEAT_DOMAIN=orbeat.example.com
# Email for Let's Encrypt registration / expiry notices.
ACME_EMAIL=admin@example.com

# Postgres (app DB + Keycloak DB share this instance).
POSTGRES_PASSWORD=change-me-strong

# Keycloak bootstrap admin (first boot only; change/disable after).
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me-strong

# --- Backups (pg_dump sidecar) ---
# How often to back up (seconds; default 86400 = daily) and how many rotating
# backup SETS to keep in the orbeat-backups volume (default 7; 0 = keep every
# set forever). Each set is one directory holding a dump of BOTH databases,
# orbeat and keycloak, restore both halves or neither. Copy the volume offsite
# for a real 3-2-1 story (see the runbook).
ORBEAT_BACKUP_INTERVAL=86400
ORBEAT_BACKUP_KEEP=7

# --- Audit retention (opt-in) ---
# Prune audit_event rows older than N days (0 = keep forever = default). Deletes
# are permanent from the LIVE db — rely on backups for the archived record.
ORBEAT_AUDIT_RETENTION_DAYS=0
# How often the prune job runs (Go duration; default 24h).
ORBEAT_AUDIT_RETENTION_INTERVAL=24h
# Max rows a single audit export streams (0 = unlimited; default 100000).
ORBEAT_AUDIT_EXPORT_MAX_ROWS=100000

# --- Every other runtime knob ---
# docker-compose.prod.yml forwards each of these to whichever service reads it,
# so setting one here now applies (before 2026-08-30 several of them did not
# reach either container at all). Leave a line out to keep the built-in default.
# `.env.example` at the repo root documents what each one does and what happens
# when it is unset; only the names differ in behaviour, not the meanings.
#
# ORBEAT_ARTIFACT_REVISION_KEEP=20        # 0/unset = keep every revision
# ORBEAT_DEPLOYMENT_REGISTRY=true         # Enterprise; unset = endpoint absent
# ORBEAT_DEPLOYMENT_RETENTION_DAYS=90     # unset = 90; 0 = keep forever
# ORBEAT_USAGE_RETENTION_DAYS=90          # Enterprise
# ORBEAT_CONTACT_EMAIL=support@your-org.example
# ORBEAT_INTERCEPT=1                      # gateway runtime call interception
# ORBEAT_GATEWAY_MAX_INFLIGHT=8           # per-principal concurrent tools/call
# ORBEAT_USAGE_FLUSH_INTERVAL=60s
# ORBEAT_LOG_FORMAT=json
# ORBEAT_LOG_LEVEL=info
# ORBEAT_OTEL_ENDPOINT=otel-collector:4317  # no collector ships in this stack
# ORBEAT_OTEL_SAMPLE_RATIO=1.0
# ORBEAT_OTEL_INSECURE=true
# ORBEAT_SCAN_LLM_ENDPOINT=https://llm-gateway.internal
# ORBEAT_SCAN_LLM_PROVIDER=openai
# ORBEAT_SCAN_LLM_MODEL=<model-id>
# ORBEAT_SCAN_LLM_KEY_REF=vault:secret/orbeat/llm#key
# ORBEAT_SCAN_LLM_TIMEOUT=15s
# ORBEAT_MARKETPLACE_GIT_URL=/data/marketplace
# ORBEAT_MARKETPLACE_GIT_CREDENTIAL_REF=env:ORBEAT_GIT_TOKEN
# ORBEAT_MARKETPLACE_GIT_TIMEOUT=120s
#
# ORBEAT_OTEL_SERVICE_NAME is deliberately NOT settable here: one value would
# name the api and the gateway identically and merge two hops into one in any
# trace backend, so the compose file pins each service's own.

# --- Catalog env: secret references (optional) ---
# Which environment variables an mcp_server secretRef/tlsCaRef may name through
# "env:". Comma-separated prefixes; a trailing "*" is accepted and ignored.
# Unset means ORBEAT_UPSTREAM_, and there is no value meaning "any variable"
# ("" and "*" both fall back to the default). Widen it only for names you are
# willing to let any admin send to a server they configure. Also export the
# variables themselves into the api and gateway services, which this compose
# file does not do for names it has never heard of.
# ORBEAT_SECRET_ENV_ALLOW=ORBEAT_UPSTREAM_

# --- Virtual keys (optional, Enterprise) ---
# Leave all three commented out unless you need robot (CI job, script,
# unattended agent) gateway credentials; an empty/absent ORBEAT_DCR_CLIENT_ID
# keeps the feature off. Set all three together: leaving
# ORBEAT_DCR_CLIENT_ID set while ORBEAT_DCR_CLIENT_SECRET_REF is blank
# resolves to an empty secret silently (internal/secrets.Resolver.Resolve
# treats an empty ref as "no credential", not an error) rather than refusing
# to start, so a partial edit here fails at the first Keycloak call, not at
# boot. See docs/runbooks/production-deployment.md "Virtual keys (optional,
# Enterprise)" for the Keycloak-side step this needs first (retrieving the
# secret Keycloak generates for the orbeat-dcr client on first import).
# ORBEAT_DCR_CLIENT_ID=orbeat-dcr
# ORBEAT_DCR_CLIENT_SECRET_REF=env:ORBEAT_DCR_CLIENT_SECRET
# ORBEAT_DCR_CLIENT_SECRET=<the secret retrieved from the Keycloak admin console>
