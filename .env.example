# Copied to .env for local compose; values below are dev-only.
ORBEAT_HTTP_ADDR=:8080
ORBEAT_DB_URL=postgres://orbeat:orbeat@postgres:5432/orbeat?sslmode=disable

# Gateway public resource URL advertised in RFC 9728 protected-resource metadata.
ORBEAT_GATEWAY_RESOURCE_URL=http://localhost:8090

# Comma-separated browser origin allow-list for CORS (fail closed when unset).
# Origins are matched exactly: scheme+host+port, no trailing slash.
# ORBEAT_CORS_ORIGINS=http://localhost:8081,http://localhost:5173

# OIDC resource-server settings — REQUIRED by orbeat-api and orbeat-gateway
# (startup fails without them). The compose file sets both per service, which is
# why they are commented here; set them explicitly for any non-compose deploy.
# The audience is per-service: orbeat-api for the api, orbeat-gateway for the gateway.
# ORBEAT_OIDC_ISSUER=http://localhost:8088/realms/orbeat
# ORBEAT_OIDC_AUDIENCE=orbeat-api

# Optional: name of the single tenant to resolve (default "default").
# ORBEAT_TENANT_NAME=default

# Optional: server-reachable OIDC base URL when the public issuer URL differs from
# the URL this service can actually reach. Compose sets Keycloak's public hostname to
# localhost:8088 (so browser tokens carry iss=http://localhost:8088/realms/orbeat) but
# api/gateway containers reach Keycloak via Docker DNS at keycloak:8080. Set this to
# the container-reachable URL; tokens are still validated against ORBEAT_OIDC_ISSUER.
# Omit (or leave empty) when the issuer URL is directly reachable by this service.
# SECURITY: this must point at a TRUSTED host — its discovery document determines
# the JWKS source for signature verification. The fetched doc's issuer must still
# match ORBEAT_OIDC_ISSUER (asserted), and token iss is enforced against it.
# ORBEAT_OIDC_DISCOVERY_URL=http://keycloak:8080/realms/orbeat

# Postgres container
POSTGRES_USER=orbeat
POSTGRES_PASSWORD=orbeat
POSTGRES_DB=orbeat

# Marketplace git target for artifact publishing.
# Dev / CI (in-container): a local path writable by the nonroot distroless user.
#   The publisher commits the rendered marketplace tree in place — no credentials.
# ORBEAT_MARKETPLACE_GIT_URL=/tmp/orbeat-marketplace
#
# Production (remote): a git repository URL; the publisher clones, commits, and pushes.
#   Pair with ORBEAT_MARKETPLACE_GIT_CREDENTIAL_REF to supply the push token via the
#   SecretsProvider (e.g. "env:ORBEAT_GIT_TOKEN" reads the token from the env).
# ORBEAT_MARKETPLACE_GIT_URL=https://github.com/your-org/your-marketplace.git
# ORBEAT_MARKETPLACE_GIT_CREDENTIAL_REF=env:ORBEAT_GIT_TOKEN
#
# Bounds a single marketplace publish run (clone/fetch/push + secrets resolve).
# Go duration; default 120s. A hung remote otherwise blocks the publish worker.
# ORBEAT_MARKETPLACE_GIT_TIMEOUT=120s

# Secret references (MCP-server credentials, the git push token above, any future
# secret) are scheme-prefixed; the DB/config store references only, never raw
# secrets, and resolution is fail-closed. Available schemes:
#   env:NAME                         process env (always available)
#   vault:<mount>/<path>#<field>     Vault KV v2 — reads VAULT_ADDR + VAULT_TOKEN
#   awssm:<name-or-arn>[#<jsonkey>]  AWS Secrets Manager — AWS default credential chain + AWS_REGION
# A vault:/awssm: ref with an unconfigured/unreachable backend errors (fail-closed:
# the gateway skips the upstream, the publisher refuses the push). An env-only
# deployment needs no Vault/AWS config.

# Logging — structured JSON to stdout, streamable to Kafka/CloudWatch by a
# platform log-shipper. Every service logs one line per request plus dual-emits
# audit events as event="audit" lines (the Postgres audit table stays the
# durable source of truth).
# ORBEAT_LOG_FORMAT=json   # json (default) | text (friendlier for local dev)
# ORBEAT_LOG_LEVEL=info    # debug | info | warn | error

# OpenTelemetry — traces + metrics via OTLP/gRPC to a collector. Unset = disabled
# (no-op providers, zero overhead — the default). The collector routes to your
# backend (Jaeger/Tempo for traces, Prometheus/CloudWatch for metrics). When
# enabled, trace_id/span_id are added to the structured logs so logs correlate
# with traces.
# ORBEAT_OTEL_ENDPOINT below is only reachable locally behind the compose
# "observability" profile — `docker compose -f deploy/docker-compose.yml
# --profile observability up`. Setting the variable alone starts nothing;
# compose profiles gate services, not env vars on other services. Full
# start/traffic/teardown flow: docs/runbooks/observability.md.
# ORBEAT_OTEL_ENDPOINT=otel-collector:4317
# ORBEAT_OTEL_SERVICE_NAME=orbeat-api
# ORBEAT_OTEL_SAMPLE_RATIO=1.0

# Optional LLM content scanner (semantic governance judge at artifact submit).
# Unset ORBEAT_SCAN_LLM_ENDPOINT = disabled (rule-based scanner only — the
# default). Advisory only: LLM findings are warn/info, never a block; the
# deterministic rules keep sole block authority. The key is a secrets ref
# (env:/vault:/awssm:), resolved fail-closed at startup.
# ORBEAT_SCAN_LLM_ENDPOINT=https://llm-gateway.internal
# ORBEAT_SCAN_LLM_PROVIDER=openai        # openai | anthropic
# ORBEAT_SCAN_LLM_MODEL=<model-id>
# ORBEAT_SCAN_LLM_KEY_REF=vault:secret/orbeat/llm#key
# ORBEAT_SCAN_LLM_TIMEOUT=15s

# Per-principal rate limiting (orbeat-api + orbeat-gateway) — a token bucket
# keyed on (subject, client_id from the OAuth `azp` claim), so one runaway
# authenticated caller cannot amplify into unbounded database load. A bad
# value never silently disables limiting: only an explicit RPS of "0" does
# that; garbage/negative values fall back to the binary's default.
#   ORBEAT_RATELIMIT_RPS      steady requests/sec per principal.
#                              api default 50, gateway default 20.
#   ORBEAT_RATELIMIT_BURST    bucket capacity per principal (clamped >= 1 —
#                              a literal 0 would deny every request).
#                              api default 200, gateway default 60.
#   ORBEAT_RATELIMIT_INIT_RPS gateway-only: a separate, tighter budget for
#                              session-creating `initialize` calls. Default 1.
# A batch/administrative client (a CI job, an `orbeat-sync` cron run hitting
# many endpoints back to back) can legitimately need a higher burst than an
# interactive admin — raise ORBEAT_RATELIMIT_BURST for that principal's
# deployment rather than raising everyone's default. See
# deploy/docker-compose.yml's api service for a worked example: this repo's
# own portal e2e suite shares one (subject=boss, client=orbeat-cli) bucket
# across three spec files and needed exactly this.
# ORBEAT_RATELIMIT_RPS=50
# ORBEAT_RATELIMIT_BURST=200
# ORBEAT_RATELIMIT_INIT_RPS=1

# Audit retention (orbeat-api) — bound audit_event growth. OFF by default
# (0 = keep forever). Deletes are permanent from the live DB; enable only with
# backups in place (the prod backup sidecar is the archive). Also: the audit
# export cap (0 = unlimited; default 100000).
# ORBEAT_AUDIT_RETENTION_DAYS=90
# ORBEAT_AUDIT_RETENTION_INTERVAL=24h
# ORBEAT_AUDIT_EXPORT_MAX_ROWS=100000

# Artifact revision pruning (orbeat-api) — bound artifact_revision growth by
# keeping only the newest N revisions per artifact. OFF by default (unset, 0,
# negative or unparseable = keep forever). The prune runs inside the same
# transaction that appends the revision, so it fires only on approve and
# rollback — the two writers — and never on an artifact nobody approves again.
# Deletes are permanent from the live DB; the prod backup sidecar is the
# archive, so a pruned revision survives in every retained dump and a restore
# brings it back. N is a rollback budget, and the two smallest values are
# degenerate enough that cmd/api warns about them at startup:
#   1  keeps only the revision just written, so no rollback to earlier content
#      is ever possible — every real target 404s. (Rolling back to the current
#      revision is a different answer: 409, store.ErrRollbackNoop.)
#   2  leaves exactly one usable rollback step, and taking it spends it — the
#      rollback appends a revision whose own prune deletes the row it just
#      restored from. A useful floor is well above 2.
# Storage bound: artifacts × N × 80 KiB worst case (64 KiB content + 16 KiB
# memory seed, the govern caps). Operational notes:
# docs/runbooks/production-deployment.md §7 "Artifact revision pruning".
# ORBEAT_ARTIFACT_REVISION_KEEP=20

# Community edition cap contact (orbeat-api). A Community build refuses a write
# that would exceed one of its caps (10 active MCP servers, 1 custom role, 10
# active seats) with 402 and a JSON body naming the resource, the limit, the
# current count and this address; the portal's dialog renders the address as a
# mailto: link. Default info@orbeat.org, which is the project's own address,
# so a self-hosted install should point it at its own support inbox. The value
# is trimmed, and empty or whitespace-only keeps the default, so an unset or
# blank variable never produces a blank contact. Read only by orbeat-api;
# orbeat-gateway calls the same config.Load() and ignores this key. Inert in an
# Enterprise build, where every cap is unlimited and no 402 is ever produced.
# Operator notes: docs/runbooks/community-edition.md.
# ORBEAT_CONTACT_EMAIL=support@your-org.example

# Portal (orbeat-portal) — static SPA server (go:embed, SPA fallback).
# Serves on :8081; compose sets ORBEAT_HTTP_ADDR=:8081 at runtime.
# The VITE_* API/gateway/OIDC URLs are baked at image build time via ARGs in
# deploy/Dockerfile.portal — they are NOT runtime env vars.
# ORBEAT_HTTP_ADDR=:8081
