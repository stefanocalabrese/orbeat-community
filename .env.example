# Copied to .env for local compose; values below are dev-only.
ORBEAT_HTTP_ADDR=:8080
ORBEAT_DB_URL=postgres://orbeat:orbeat@postgres:5432/orbeat?sslmode=disable

# Gateway public resource URL advertised in RFC 9728 protected-resource metadata.
ORBEAT_GATEWAY_RESOURCE_URL=http://localhost:8090

# Comma-separated browser origin allow-list for CORS (fail closed when unset).
# Origins are matched exactly: scheme+host+port, no trailing slash.
# ORBEAT_CORS_ORIGINS=http://localhost:8081,http://localhost:5173

# OIDC resource-server settings — REQUIRED by orbeat-api and orbeat-gateway
# (startup fails without them). The compose file sets both per service, which is
# why they are commented here; set them explicitly for any non-compose deploy.
# The audience is per-service: orbeat-api for the api, orbeat-gateway for the gateway.
# ORBEAT_OIDC_ISSUER=http://localhost:8088/realms/orbeat
# ORBEAT_OIDC_AUDIENCE=orbeat-api

# Optional: name of the single tenant to resolve (default "default").
# ORBEAT_TENANT_NAME=default

# Optional: server-reachable OIDC base URL when the public issuer URL differs from
# the URL this service can actually reach. Compose sets Keycloak's public hostname to
# localhost:8088 (so browser tokens carry iss=http://localhost:8088/realms/orbeat) but
# api/gateway containers reach Keycloak via Docker DNS at keycloak:8080. Set this to
# the container-reachable URL; tokens are still validated against ORBEAT_OIDC_ISSUER.
# Omit (or leave empty) when the issuer URL is directly reachable by this service.
# SECURITY: this must point at a TRUSTED host — its discovery document determines
# the JWKS source for signature verification. The fetched doc's issuer must still
# match ORBEAT_OIDC_ISSUER (asserted), and token iss is enforced against it.
# ORBEAT_OIDC_DISCOVERY_URL=http://keycloak:8080/realms/orbeat

# Postgres container
POSTGRES_USER=orbeat
POSTGRES_PASSWORD=orbeat
POSTGRES_DB=orbeat

# Marketplace git target for artifact publishing.
# Dev / CI (in-container): a local path writable by the nonroot distroless user.
#   The publisher commits the rendered marketplace tree in place — no credentials.
# ORBEAT_MARKETPLACE_GIT_URL=/tmp/orbeat-marketplace
#
# Production (remote): a git repository URL; the publisher clones, commits, and pushes.
#   Pair with ORBEAT_MARKETPLACE_GIT_CREDENTIAL_REF to supply the push token via the
#   SecretsProvider (e.g. "env:ORBEAT_GIT_TOKEN" reads the token from the env).
# ORBEAT_MARKETPLACE_GIT_URL=https://github.com/your-org/your-marketplace.git
# ORBEAT_MARKETPLACE_GIT_CREDENTIAL_REF=env:ORBEAT_GIT_TOKEN
#
# Bounds a single marketplace publish run (clone/fetch/push + secrets resolve).
# Go duration; default 120s. A hung remote otherwise blocks the publish worker.
# ORBEAT_MARKETPLACE_GIT_TIMEOUT=120s

# Secret references (MCP-server credentials, the git push token above, any future
# secret) are scheme-prefixed; the DB/config store references only, never raw
# secrets, and resolution is fail-closed. Available schemes:
#   env:NAME                         process env (always available)
#   vault:<mount>/<path>#<field>     Vault KV v2 — reads VAULT_ADDR + VAULT_TOKEN
#   awssm:<name-or-arn>[#<jsonkey>]  AWS Secrets Manager — AWS default credential chain + AWS_REGION
# A vault:/awssm: ref with an unconfigured/unreachable backend errors (fail-closed:
# the gateway skips the upstream, the publisher refuses the push). An env-only
# deployment needs no Vault/AWS config.
#
# ORBEAT_SECRET_ENV_ALLOW bounds which environment variables an "env:" ref may
# name when that ref came from the CATALOG, i.e. an mcp_server secretRef or
# tlsCaRef written by an admin over the API. Comma-separated prefixes; a trailing
# "*" is accepted and ignored. Unset means the default below, NOT "any variable":
# without it, any admin could store secretRef "env:ORBEAT_DB_URL" against a server
# they point at their own host, and the gateway would send the Postgres password
# to it as a bearer token. A name outside the list is refused with 400 at write
# time, and an already-stored one makes the gateway skip that upstream.
#
# There is deliberately no value meaning "allow everything": "*" and "" both
# fall back to the default. Widen it by naming your own prefix.
# ORBEAT_SECRET_ENV_ALLOW=ORBEAT_UPSTREAM_
#
# It does NOT apply to the refs orbeat reads from its own process environment
# (ORBEAT_MARKETPLACE_GIT_CREDENTIAL_REF, ORBEAT_SCAN_LLM_KEY_REF,
# ORBEAT_DCR_CLIENT_SECRET_REF). Those are set by whoever already owns this
# process's environment, so constraining them would prevent nothing; name those
# variables whatever you like.

# Logging — structured JSON to stdout, streamable to Kafka/CloudWatch by a
# platform log-shipper. Every service logs one line per request plus dual-emits
# audit events as event="audit" lines (the Postgres audit table stays the
# durable source of truth).
# ORBEAT_LOG_FORMAT=json   # json (default) | text (friendlier for local dev)
# ORBEAT_LOG_LEVEL=info    # debug | info | warn | error

# OpenTelemetry — traces + metrics via OTLP/gRPC to a collector. Unset = disabled
# (no-op providers, zero overhead — the default). The collector routes to your
# backend (Jaeger/Tempo for traces, Prometheus/CloudWatch for metrics). When
# enabled, trace_id/span_id are added to the structured logs so logs correlate
# with traces.
# ORBEAT_OTEL_ENDPOINT below is only reachable locally behind the compose
# "observability" profile — `docker compose -f deploy/docker-compose.yml
# --profile observability up`. Setting the variable alone starts nothing;
# compose profiles gate services, not env vars on other services. Full
# start/traffic/teardown flow: docs/runbooks/observability.md.
# ORBEAT_OTEL_ENDPOINT=otel-collector:4317
# ORBEAT_OTEL_SERVICE_NAME=orbeat-api
# ORBEAT_OTEL_SAMPLE_RATIO=1.0

# Optional LLM content scanner (semantic governance judge at artifact submit).
# Unset ORBEAT_SCAN_LLM_ENDPOINT = disabled (rule-based scanner only — the
# default). Advisory only: LLM findings are warn/info, never a block; the
# deterministic rules keep sole block authority. The key is a secrets ref
# (env:/vault:/awssm:), resolved fail-closed at startup.
# ORBEAT_SCAN_LLM_ENDPOINT=https://llm-gateway.internal
# ORBEAT_SCAN_LLM_PROVIDER=openai        # openai | anthropic
# ORBEAT_SCAN_LLM_MODEL=<model-id>
# ORBEAT_SCAN_LLM_KEY_REF=vault:secret/orbeat/llm#key
# ORBEAT_SCAN_LLM_TIMEOUT=15s
#
# NOTE, so the "unset = disabled" line above is not read as covering the dev
# stack: deploy/docker-compose.yml sets these four on the api service itself,
# pointing at the fake-llm fixture (deploy/fakellm/main.go). So `make up`,
# `make smoke` and the Playwright suite all run WITH the layer on. That
# fixture returns an empty findings list for everything except one sentinel
# string, which is what stops it from changing any other outcome, and its
# findings are canned: it gives the code path coverage and says nothing about
# how a real model would judge real content.

# Runtime call interception (orbeat-gateway) -- the deterministic content
# scanner above, applied to tool calls instead of artifact submissions. Unset
# ORBEAT_INTERCEPT = disabled (the default): the hook is never installed, not
# installed-and-inert -- no scan, no added latency, no behaviour change. Ships
# in BOTH editions (the deterministic scanner already does; this applies it
# to a different payload). Any non-empty value turns it on.
#
# When set, the gateway scans a tool call's arguments before it reaches the
# upstream, and its result after the upstream has already answered, using
# the same scanSecrets/scanReserved/size rules artifact submission uses. A
# `block` finding on the arguments side denies the call outright -- the
# upstream never runs. A `block` finding on the result side replaces what
# the agent sees with a fixed refusal naming the tool and the rule -- but the
# upstream has already run by then: this stops the agent from seeing a
# leak, it does NOT stop the leak itself. A `warn`/`info` finding never
# denies either direction; it is only audited (gateway.call.flagged /
# gateway.call.blocked), recording the rule and severity that fired, never
# the content that matched.
#
# Known limitation: this uses the deterministic scanner only --
# ORBEAT_SCAN_LLM_* above has no effect here, because the CompositeScanner
# construction that adds that advisory layer lives in cmd/api's own main
# package, not importable from cmd/gateway.
# ORBEAT_INTERCEPT=1

# Per-principal rate limiting (orbeat-api + orbeat-gateway) — a token bucket
# keyed on (subject, client_id from the OAuth `azp` claim), so one runaway
# authenticated caller cannot amplify into unbounded database load. A bad
# value never silently disables limiting: only an explicit RPS of "0" does
# that; garbage/negative values fall back to the binary's default.
#   ORBEAT_RATELIMIT_RPS      steady requests/sec per principal.
#                              api default 50, gateway default 20.
#   ORBEAT_RATELIMIT_BURST    bucket capacity per principal (clamped >= 1 —
#                              a literal 0 would deny every request).
#                              api default 200, gateway default 60.
#   ORBEAT_RATELIMIT_INIT_RPS gateway-only: a separate, tighter budget for
#                              session-creating `initialize` calls. Default 1.
# A batch/administrative client (a CI job, an `orbeat-sync` cron run hitting
# many endpoints back to back) can legitimately need a higher burst than an
# interactive admin — raise ORBEAT_RATELIMIT_BURST for that principal's
# deployment rather than raising everyone's default. See
# deploy/docker-compose.yml's api service for a worked example: this repo's
# own portal e2e suite shares one (subject=boss, client=orbeat-cli) bucket
# across three spec files and needed exactly this.
# ORBEAT_RATELIMIT_RPS=50
# ORBEAT_RATELIMIT_BURST=200
# ORBEAT_RATELIMIT_INIT_RPS=1

# Audit retention (orbeat-api) — bound audit_event growth. OFF by default
# (0 = keep forever). Deletes are permanent from the live DB; enable only with
# backups in place (the prod backup sidecar is the archive). Also: the audit
# export cap (0 = unlimited; default 100000).
# ORBEAT_AUDIT_RETENTION_DAYS=90
# ORBEAT_AUDIT_RETENTION_INTERVAL=24h
# ORBEAT_AUDIT_EXPORT_MAX_ROWS=100000

# Artifact revision pruning (orbeat-api) — bound artifact_revision growth by
# keeping only the newest N revisions per artifact. OFF by default (unset, 0,
# negative or unparseable = keep forever). The prune runs inside the same
# transaction that appends the revision, so it fires only on approve and
# rollback — the two writers — and never on an artifact nobody approves again.
# Deletes are permanent from the live DB; the prod backup sidecar is the
# archive, so a pruned revision survives in every retained dump and a restore
# brings it back. N is a rollback budget, and the two smallest values are
# degenerate enough that cmd/api warns about them at startup:
#   1  keeps only the revision just written, so no rollback to earlier content
#      is ever possible — every real target 404s. (Rolling back to the current
#      revision is a different answer: 409, store.ErrRollbackNoop.)
#   2  leaves exactly one usable rollback step, and taking it spends it — the
#      rollback appends a revision whose own prune deletes the row it just
#      restored from. A useful floor is well above 2.
# Storage bound: artifacts × N × 80 KiB worst case (64 KiB content + 16 KiB
# memory seed, the govern caps). Operational notes:
# docs/runbooks/production-deployment.md §7 "Artifact revision pruning".
# ORBEAT_ARTIFACT_REVISION_KEEP=20

# Artifact deployment registry (orbeat-api, Enterprise). OFF unless set, and
# the default IS the disclosure: turning this on starts recording, per named
# developer and per machine, which artifacts that machine holds, at which
# revision, and when it last checked in. Only an explicit affirmative counts
# (1, t, true, TRUE and the rest of strconv.ParseBool's set); "yes", "on" and a
# typo all read as off, because a value nobody can read as a clear yes must
# never switch on collection about staff. Inert in a Community build: the route
# is never registered and GET /v1/sync/config answers deploymentRegistry false
# however this is set.
#
# COLLECTED, and it is exactly six values per row plus the tenant scope, with
# no field on the wire to carry a seventh: user_id (a row that already exists
# in users), install_id (an opaque uuid the client generates once into
# ~/.config/orbeat/install.json), artifact_id, revision, pinned, reported_at.
# The whole POST /v1/sync/deployments body is {"installId": "...",
# "artifacts": [{"artifactId": "...", "revision": N, "pinned": true|false}]},
# and the decoder sets DisallowUnknownFields, so a body offering anything else
# is a 400 rather than a field quietly ignored. pinned is artifact-version
# pinning's whole contribution here (docs/specs/2026-08-22-orbeat-artifact-
# version-pinning-design.md sec 9.4): "this install applied revision because a
# local pin named it", not merely which revision it holds, and it is what lets
# GET /v1/admin/artifacts/{id}/deployments tell a deliberate hold apart from a
# laptop nobody has opened. It ships and is read only where pinning itself
# does (Enterprise, GET /v1/sync/config's pinning flag), so a client talking to
# a server without it never puts the key on the wire at all.
#
# NOT COLLECTED, none of which has a column or a wire field: file paths,
# project directory paths, hostname, username, OS or architecture,
# orbeat-sync's own version, local file timestamps, anything about files orbeat
# does not manage, and any count of a developer's projects. A rule artifact
# that landed in six registered projects is ONE row, not six, so the
# project-path axis is absent from the format rather than left empty.
#
# EXPOSED: aggregates only. GET /v1/admin/artifacts/{id}/deployments answers
# install and user counts, a per-revision histogram, how many installs are
# behind the newest approved revision, and the oldest reported_at. No orbeat
# route and no portal page returns a subject, an email, a display name or an
# install id out of this table, so naming an individual takes a Postgres
# credential, the same bar as reading audit_event. That bar is a real control
# at 200 developers and close to none at 4, where "2 of 3 installs are on
# revision 2" names people: this is a narrower exposure, not anonymisation.
#
# ERASURE: DELETE /v1/admin/users/{id} cascades (migration 00017), destroying
# every deployment row about that person along with the user row. Rows also
# expire on their own after ORBEAT_DEPLOYMENT_RETENTION_DAYS below, default 90.
#
# The developer is told too: `orbeat-sync status` prints this machine's install
# id and the API it reports to, offline, without being asked.
# Who owes the workforce a notice, and why a config default cannot discharge
# it: docs/runbooks/production-deployment.md §7 "Artifact deployment registry".
# ORBEAT_DEPLOYMENT_REGISTRY=true

# Artifact deployment retention (orbeat-api, Enterprise). How many days an
# artifact_deployment row survives without a fresh report before the nightly
# prune deletes it. ON by default at 90 days, which is the opposite of
# ORBEAT_AUDIT_RETENTION_DAYS above and is deliberate: an audit row is a
# compliance record and deleting it is a loss, while a deployment row is a
# claim about a named person's machine that stops being true the moment that
# machine goes quiet. Keeping one forever makes an admin page say twelve
# people have an artifact when four of those laptops were wiped last spring,
# which is a wrong answer rather than a smaller one.
#   0  keep forever. Accepted, and warned at startup naming that consequence.
# Unset, blank, negative or unparseable all mean 90: only a readable 0 turns
# the prune off, because 0 is the dangerous answer for this table.
# The prune runs whether or not ORBEAT_DEPLOYMENT_REGISTRY is currently on, so
# switching collection off still lets the rows already collected age out.
# ORBEAT_DEPLOYMENT_RETENTION_DAYS=90

# Community edition cap contact (orbeat-api). A Community build refuses a write
# that would exceed one of its caps (10 active MCP servers, 1 custom role, 10
# active seats) with 402 and a JSON body naming the resource, the limit, the
# current count and this address; the portal's dialog renders the address as a
# mailto: link. Default info@orbeat.org, which is the project's own address,
# so a self-hosted install should point it at its own support inbox. The value
# is trimmed, and empty or whitespace-only keeps the default, so an unset or
# blank variable never produces a blank contact. Read only by orbeat-api;
# orbeat-gateway calls the same config.Load() and ignores this key. Inert in an
# Enterprise build, where every cap is unlimited and no 402 is ever produced.
# Operator notes: docs/runbooks/community-edition.md.
# ORBEAT_CONTACT_EMAIL=support@your-org.example

# Virtual keys (orbeat-api, Enterprise). A robot (a CI job, a script, an
# unattended agent) can get its own gateway credential: a Keycloak client
# registered by Dynamic Client Registration, authenticating with
# private_key_jwt, owned by a role and narrowable to specific tools. See
# docs/specs/2026-08-25-orbeat-virtual-keys-design.md.
#
# ORBEAT_DCR_CLIENT_ID and ORBEAT_DCR_CLIENT_SECRET_REF are the Keycloak
# service-account credential orbeat-api uses to register a robot's own
# client. Both empty (the default, unset here) means OFF: an unconfigured
# registrar makes POST /v1/admin/virtual-keys refuse with 503, naming both
# variables, rather than a 500 -- a deployment state, not a server bug.
# ORBEAT_DCR_CLIENT_ID=orbeat-dcr
# ORBEAT_DCR_CLIENT_SECRET_REF=env:ORBEAT_DCR_CLIENT_SECRET
#
# deploy/keycloak/orbeat-realm.json (the dev realm) already provisions this
# as the orbeat-dcr client, holding only realm-management's create-client
# role (it can create Keycloak clients and administer nothing else), with a
# committed dev secret (orbeat-dcr-dev-secret) -- but the committed dev
# deploy/docker-compose.yml does not pass either variable above to the api
# service, so turning this on locally still needs a manual addition to that
# file's environment: block, mirroring the production situation before it
# was closed (see docs/runbooks/production-deployment.md "Virtual keys
# (optional, Enterprise)" for the equivalent prod flow, which
# deploy/docker-compose.prod.yml now wires through from deploy/.env.prod).
# deploy/keycloak/orbeat-realm.prod.json provisions the same client but with
# no committed secret: Keycloak generates one at first import, and an
# operator retrieves it from the Keycloak admin console.
#
# THIS VARIABLE IS ALSO THE SEALING KEY FOR VIRTUAL-KEY CLEANUP, so read the
# rotation note before changing it. Revoking a key deletes its Keycloak
# client (migration 00030); the registration access token that makes that
# possible is stored at creation, encrypted under a key derived from
# whatever this ref resolves to. Rotating the secret makes tokens sealed
# under the old one unopenable, so every key created before the rotation
# goes back to warn-and-orphan on revoke. The keys themselves keep working
# either way -- the sealed value is not the robot's credential -- so a
# rotation costs cleanup, never access.
#
# Setting ORBEAT_DCR_CLIENT_ID with this ref UNSET now fails at startup
# rather than booting into a DCR client that 401s on every call.
#
# What stays manual: keys created before 00030 (no stored token), role
# deletion (the cascade destroys the rows; the role.delete audit event lists
# each client_id instead), and anything a WARN names. See
# docs/runbooks/production-deployment.md "Virtual key Keycloak cleanup",
# docs/threat-model.md entry 18, and docs/upgrade-guide.md §2.1.

# Usage metering and per-role quotas (orbeat-gateway + orbeat-api, Enterprise).
# Every ALLOWED tool call is counted per subject/server/tool/day, attributed to
# the role that authorized it, and an admin can cap a role at a monthly call
# total that denies once reached. See
# docs/specs/2026-08-25-orbeat-usage-metering-design.md.
#
# ORBEAT_USAGE_FLUSH_INTERVAL (orbeat-gateway) -- how often the in-memory
# counter flushes to Postgres and the quota cache refreshes. Default 60s.
# There is NO on/off switch here: counting itself is unconditional in every
# Enterprise build, because a quota an admin sets would otherwise read from a
# cache nothing ever populated. This only tunes the cadence.
# ORBEAT_USAGE_FLUSH_INTERVAL=60s
#
# THE OVERSHOOT: a role's cached quota total is only as fresh as its last
# refresh, so a burst of calls between two refreshes is invisible to
# enforcement until the next one -- a role can exceed its quota by up to one
# flush interval's worth of calls before the denial catches up. A QUOTA HERE
# IS A BUDGET, NOT A BOUNDARY: it is not a security control for bounding the
# blast radius of a compromised credential, and shortening
# ORBEAT_USAGE_FLUSH_INTERVAL only narrows the margin, it never closes it.
#
# ORBEAT_USAGE_RETENTION_DAYS (orbeat-api) -- how many days a usage_daily row
# survives before the nightly prune deletes it. ON by default at 90 days, the
# same on-by-default direction as ORBEAT_DEPLOYMENT_RETENTION_DAYS above and
# for the same reason: a usage_daily row is a per-day, per-tool count whose
# operational relevance shrinks once that month's quota window has closed,
# not a compliance record the way an audit_event row is.
#   0  keep forever. Only a readable 0 turns the prune off.
# Unset, blank, negative or unparseable all mean 90.
# ORBEAT_USAGE_RETENTION_DAYS=90
#
# No migration-time knob: migration 00022 (usage_daily, role_quota) always
# runs. Inert in a Community build -- the counter is a no-op stub there, so no
# usage_daily row is ever written regardless of traffic, and the retention
# loop never starts because there is nothing to prune.
#
# Full risk statement (the activity trail this creates, and what an operator
# can and cannot do about it): docs/threat-model.md entry 21.

# Portal (orbeat-portal) -- static SPA server (go:embed, SPA fallback).
# Serves on :8081; compose sets ORBEAT_HTTP_ADDR=:8081 at runtime.
# ORBEAT_HTTP_ADDR=:8081
#
# THIS PARAGRAPH USED TO SAY THE OPPOSITE. Until audit finding B29 it read
# "the VITE_* API/gateway/OIDC URLs are baked at image build time via ARGs in
# deploy/Dockerfile.portal -- they are NOT runtime env vars". v1.20.0 replaced
# that arrangement and the sentence outlived it by six releases. The whole
# point of the change was that one signed portal image runs at ANY domain
# without a rebuild, which is impossible if its URLs are baked. cmd/portal
# reads the five values below at boot and serves them from GET /config.json,
# which the SPA fetches before the OIDC provider mounts.
#
# ORBEAT_PORTAL_API_BASE            -- orbeat-api base URL the SPA calls
# ORBEAT_PORTAL_GATEWAY_URL         -- gateway URL shown on the Connect page
# ORBEAT_PORTAL_OIDC_AUTHORITY      -- OIDC issuer the browser is sent to
# ORBEAT_PORTAL_OIDC_CLIENT_ID      -- public client id for the SPA
# ORBEAT_PORTAL_MARKETPLACE_SOURCE  -- marketplace source shown in install copy
#
# ORBEAT_PORTAL_CONNECT_SRC (orbeat-portal) -- space-separated origins the SPA
# is allowed to call, emitted as the CSP connect-src. Effectively MANDATORY in
# any real deployment: unset, cmd/portal logs a warning and emits
# `connect-src 'self'`, and the browser then blocks every api, OIDC and
# gateway call the SPA makes. The page loads and does nothing, which is the
# worst failure shape available. Set it to the api, issuer and gateway origins.
# ORBEAT_PORTAL_CONNECT_SRC=https://orbeat.example.com https://auth.example.com https://mcp.example.com

# ORBEAT_GATEWAY_MAX_INFLIGHT (orbeat-gateway) -- per-principal cap on
# concurrent tools/call requests. Default 8. This is a concurrency cap, not a
# rate limit: ORBEAT_RATELIMIT_* bound calls per second, this bounds how many
# may be in flight at once, which is what protects a slow upstream from one
# principal's fan-out.
# ORBEAT_GATEWAY_MAX_INFLIGHT=8

# ORBEAT_OTEL_INSECURE (orbeat-api, orbeat-gateway) -- whether the OTLP/gRPC
# exporter connects in plaintext. Default "true", which matches the collector
# sitting on the same compose network. Set "false" when the collector is
# reached across a network you do not control. Inert unless
# ORBEAT_OTEL_ENDPOINT is set. An unparseable value warns and falls back to
# insecure=true rather than failing the boot.
# ORBEAT_OTEL_INSECURE=true

# ---------------------------------------------------------------------------
# orbeat-sync (the CLI, run on a developer machine -- NOT a server process).
# Listed here because the drift gate reads every ORBEAT_* name the Go source
# consumes, and a client variable that appears in no example file is exactly
# as undiscoverable as a server one.
# ---------------------------------------------------------------------------

# ORBEAT_API_URL (orbeat-sync) -- orbeat-api base URL the CLI talks to.
# Default http://localhost:8080.
# ORBEAT_API_URL=https://orbeat.example.com

# ORBEAT_SYNC_CLIENT_ID (orbeat-sync) -- public OAuth client id the CLI uses
# for its device-flow login. Default orbeat-cli, which the shipped realms
# define; override only if your realm names it differently.
# ORBEAT_SYNC_CLIENT_ID=orbeat-cli
